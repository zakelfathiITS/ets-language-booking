# Copy to `.env` to override the docker-compose defaults. Never commit `.env`.

# Published ports on the host
BACKEND_PORT=8000
FRONTEND_PORT=3000
MONGO_PORT=27017

# MongoDB root account (local container only)
MONGO_ROOT_USERNAME=ets
MONGO_ROOT_PASSWORD=ets_local_password
MONGODB_DB=ets_booking

# Symfony
APP_SECRET=local_only_change_me_in_production
JWT_PASSPHRASE=local_only_jwt_passphrase_change_me
APP_TIMEZONE=Europe/Paris
# 1 = load demo accounts and sessions on first start
APP_SEED_DEMO_DATA=1
# 1 when served over HTTPS (the token cookie then requires it)
AUTH_COOKIE_SECURE=0
# Shared by the web client's /api proxy and the API
API_PROXY_SECRET=local_only_proxy_secret_change_me

# Frontend
# One-click demo accounts on the login page
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
