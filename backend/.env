# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
# Must be provided by the environment outside of dev/test.
APP_SECRET=
###< symfony/framework-bundle ###

# Timezone in which session dates and times are entered and displayed (stored in UTC).
APP_TIMEZONE=Europe/Paris

###> doctrine/mongodb-odm-bundle ###
# Format described at https://www.mongodb.com/docs/php-library/current/connect/connection-options/
# MONGODB_URI="mongodb://username:password@localhost:27017/?authSource=auth-db"
# MONGODB_URI="mongodb+srv://username:password@YOUR_CLUSTER_NAME.YOUR_HASH.mongodb.net/?retryWrites=true&w=majority"
# serverSelectionTimeoutMS: fail fast (driver default is 30 s) when the database is unreachable.
MONGODB_URI=mongodb://localhost:27017/?serverSelectionTimeoutMS=3000
MONGODB_DB=ets_booking
###< doctrine/mongodb-odm-bundle ###

###> lexik/jwt-authentication-bundle ###
# The key pair is generated on first start (bin/console lexik:jwt:generate-keypair).
# The passphrase below only protects local keys: set a real one in production.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=354ac1ddbdae1b30cf0374e895e946ae2764165f49ec13d4ed43432cc79ce784
# Token lifetime in seconds.
JWT_TTL=3600
# The token cookie is HTTPS-only; 0 only for a local stack served over plain HTTP.
AUTH_COOKIE_SECURE=1
###< lexik/jwt-authentication-bundle ###

# Secret shared with the web client's proxy, which sends it with the visitor's
# address (X-Client-Ip). Empty: forwarded addresses are ignored.
API_PROXY_SECRET=

###> symfony/lock ###
# Used by login throttling. "flock" suits a single instance.
LOCK_DSN=flock
###< symfony/lock ###
