parameters:
    level: 8
    paths:
        - src/
        - tests/
    tmpDir: var/cache/phpstan
    symfony:
        # Generated by `bin/console cache:warmup` in the dev environment.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

# Doctrine ODM reads and writes mapped properties through reflection.
services:
    -
        class: App\Tests\Support\PHPStan\XmlMappedProperties
        arguments:
            mappingDirectory: %currentWorkingDirectory%/src/Infrastructure/Persistence/MongoDB/Mapping
    -
        class: App\Tests\Support\PHPStan\XmlMappedPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension
    -
        class: App\Tests\Support\PHPStan\XmlMappedPropertiesUsageProvider
        tags:
            - shipmonk.deadCode.memberUsageProvider
