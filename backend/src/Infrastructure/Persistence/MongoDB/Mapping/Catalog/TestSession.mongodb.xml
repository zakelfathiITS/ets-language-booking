<?xml version="1.0" encoding="UTF-8"?>
<!--
    Collection "sessions": (id, language, date and time, location, number of seats).
    Date and time are stored together as one UTC instant ("scheduled_at"): a single
    indexed field sorts and filters upcoming sessions without string manipulation.
-->
<doctrine-mongo-mapping xmlns="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://doctrine-project.org/schemas/odm/doctrine-mongo-mapping
                                            https://www.doctrine-project.org/schemas/odm/doctrine-mongo-mapping.xsd">

    <document name="App\Domain\Catalog\TestSession" collection="sessions">
        <id field-name="id" />

        <field field-name="language" name="language" type="string" />
        <field field-name="scheduledAt" name="scheduled_at" type="date_immutable" />
        <field field-name="location" name="location" type="string" />
        <field field-name="capacity" name="capacity" type="int" />
        <field field-name="seatsTaken" name="seats_taken" type="int" />
        <field field-name="createdAt" name="created_at" type="date_immutable" />
        <field field-name="updatedAt" name="updated_at" type="date_immutable" />

        <!--
            Listings sort by date, then by id so that pages never overlap. With
            the id in the index, rows come out already sorted: a page reads only
            the sessions it returns instead of sorting all matches in memory.
        -->
        <indexes>
            <!-- Default listing: upcoming sessions, soonest first. -->
            <index name="idx_sessions_scheduled_at_id">
                <key name="scheduledAt" order="asc" />
                <key name="id" order="asc" />
            </index>
            <!-- Listing filtered by language (equality first, then the range and the sort). -->
            <index name="idx_sessions_language_scheduled_at_id">
                <key name="language" order="asc" />
                <key name="scheduledAt" order="asc" />
                <key name="id" order="asc" />
            </index>
        </indexes>
    </document>
</doctrine-mongo-mapping>
