# The browser calls /api on this origin; the server relays to the Symfony API.
# Server-side settings, read at run time.
API_INTERNAL_URL=http://localhost:8000
# Must match the API's API_PROXY_SECRET (lets the API rate-limit per visitor).
API_PROXY_SECRET=local_only_proxy_secret_change_me

# One-click demo accounts on the login page (set to false in production).
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Timezone of session dates and times (must match the API's APP_TIMEZONE).
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris
